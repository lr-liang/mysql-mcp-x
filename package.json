{
  "name": "mysql-mcp-x",
  "version": "1.0.1",
  "description": "MySQL MCP Server for Claude Desktop, Cursor and AI assistants. Supports MySQL 8+ with built-in SQL safety protection.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mysql-mcp-x": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lr-liang/mysql-mcp-x.git"
  },
  "bugs": {
    "url": "https://github.com/lr-liang/mysql-mcp-x/issues"
  },
  "homepage": "https://github.com/lr-liang/mysql-mcp-x#readme",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "mysql",
    "mysql-mcp",
    "model-context-protocol",
    "claude",
    "cursor",
    "ai",
    "database",
    "sql"
  ],
  "author": "yinliang <liang.work@icloud.com>",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "mysql2": "^3.14.1",
    "zod": "^3.25.32"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.31.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ]
}
